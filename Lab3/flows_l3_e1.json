        "format": "<template>\n  <div :style=\"{\n    width: '30px',\n    height: '30px',\n    borderRadius: '50%',\n    backgroundColor: payload == '1' ? 'green' : 'red',\n    boxShadow: '0 0 10px ' + (payload == '1' ? 'green' : 'red')\n  }\">\n  </div>\n</template>\n\n<script>\n  export default {\n    data() {\n      return {\n        payload: '0'\n      }\n    },\n    watch: {\n      msg: function(newMsg) {\n        if (newMsg) {\n          this.payload = String(newMsg.payload)\n        }\n      }\n    }\n  }\n</script>",
