    {
        "id": "9055c08012fb1229",
        "type": "function",
        "z": "803e8be10ba18530",
        "name": "function 4",
        "func": "let data = String(msg.payload).trim();\nif (data.startsWith(\"T:\")) {\n    data = data.substring(2);\n}\nlet temp = parseFloat(data);\n\nif (isNaN(temp)) return null;\n\nlet lastSent = context.get('lastSent') || 0;\nlet now = Date.now();\nlet cooldown = 5 * 60 * 1000; // 5 Minuten in Millisekunden\n\nif (temp > 28) {\n    if (now - lastSent > cooldown) {\n        context.set('lastSent', now); // Zeit aktualisieren\n\n        msg.payload = {\n            chatId: //\"8953800748\",\n            type: \"message\",\n            content: \"⚠️ Temperatur zu hoch: \" + temp.toFixed(1) + \"°C\"\n        };\n        return msg;\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 3,
